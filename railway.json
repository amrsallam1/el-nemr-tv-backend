{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npx playwright install --with-deps chromium"
  },
  "deploy": {
    "startCommand": "php artisan serve --host=0.0.0.0 --port=$PORT",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
