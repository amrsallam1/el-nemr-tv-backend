APP_NAME="El Nemr TV"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend.example.com
APP_TIMEZONE=Africa/Cairo

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

TMDB_API_KEY=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_TOPIC=all
# Alternative to TMDB_API_KEY:
# TMDB_ACCESS_TOKEN=
TMDB_LANGUAGE=ar
TMDB_TIMEOUT_SECONDS=15

MOVIE_SYNC_ENABLED=false
MOVIE_SYNC_DAILY_AT=03:00
MOVIE_SYNC_TIMEZONE=Africa/Cairo
MOVIE_SYNC_MAX_MOVIES=50
MOVIE_SYNC_MAX_PAGES=25
MOVIE_SYNC_RETRIES=3
MOVIE_SYNC_LOCK_SECONDS=21600
MOVIE_SYNC_ALLOW_ADULT=false
MOVIE_SYNC_REQUIRE_STREAM=true
MOVIE_SYNC_CSV_PATH=movie-sync/latest.csv
STREAM_TIMEOUT_SECONDS=7

# Authorized external catalog synchronization
CONTENT_SYNC_ENABLED=false
CONTENT_WORKER_URL=https://akwam-stream-fetcher.meroo3292.workers.dev/
CONTENT_CATALOG_ORIGIN=https://akwam.it
CONTENT_ALLOWED_SOURCE_HOSTS=akwam.it,www.akwam.it
CONTENT_SYNC_DAILY_AT=04:00
CONTENT_SYNC_TIMEZONE=Africa/Cairo
CONTENT_SYNC_PAGES=2
CONTENT_SYNC_LIMIT=50
CONTENT_SYNC_MAX_PAGES=10
CONTENT_SYNC_MAX_ITEMS=200
CONTENT_WORKER_TIMEOUT_SECONDS=20
CONTENT_WORKER_RETRIES=2
CONTENT_SYNC_LOCK_SECONDS=3600
CONTENT_PLAYBACK_CACHE_SECONDS=120
CONTENT_SYNC_TOKEN=
